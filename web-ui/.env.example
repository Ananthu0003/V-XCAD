# Prisma/PostgreSQL connection strings (host-side development only — inside docker compose these
# are injected for you). PostgreSQL is not published to the network; to reach it from the host
# start it with docker-compose.dev.yml (bound to 127.0.0.1:5433). There are no default passwords:
# use the values you set as POSTGRES_* in the repo-root .env.
#
# DATABASE_URL  -> the least-privilege APPLICATION role (used by the running app).
# DIRECT_URL    -> used by the Prisma CLI (`npm run prisma:push`); for schema changes it must be the
#                  ADMIN/owner role, because the application role intentionally cannot run DDL.
DATABASE_URL=postgresql://vexcad_app:<POSTGRES_APP_PASSWORD>@127.0.0.1:5433/cad_db?schema=public
DIRECT_URL=postgresql://vexcad_admin:<POSTGRES_ADMIN_PASSWORD>@127.0.0.1:5433/cad_db?schema=public

# Service credential for calling ai-engine (sent as X-Service-Key). Server-side ONLY —
# never expose it via a NEXT_PUBLIC_* variable. Must equal ai-engine's SERVICE_API_KEY.
SERVICE_API_KEY=

# JWT signing secret for auth_token cookies (REQUIRED - never leave unset)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Server-side BFF proxy target (Next.js API routes -> FastAPI)
FASTAPI_URL=http://127.0.0.1:8000/api/v1

# Client-side URL for model/artifact loading in browser
NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000/api/v1

# Developer/admin access for showing the CAD Python code panel
# Use a fixed username and password for the admin login.
NEXT_PUBLIC_DEVELOPER_ACCESS_USERNAME=admin
NEXT_PUBLIC_DEVELOPER_ACCESS_PASSWORD=admin
