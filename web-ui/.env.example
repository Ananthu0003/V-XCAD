# Prisma/PostgreSQL connection string
# Default docker-compose credentials:
#   user: cad_user
#   password: cad_pass
#   db: cad_db
DATABASE_URL=postgresql://cad_user:cad_pass@localhost:5432/cad_db?schema=public

# JWT signing secret for auth_token cookies (REQUIRED - never leave unset)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Server-side BFF proxy target (Next.js API routes -> FastAPI)
FASTAPI_URL=http://127.0.0.1:8000/api/v1

# Client-side URL for model/artifact loading in browser
NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000/api/v1

# Developer/admin access for showing the CAD Python code panel
# Use a fixed username and password for the admin login.
NEXT_PUBLIC_DEVELOPER_ACCESS_USERNAME=admin
NEXT_PUBLIC_DEVELOPER_ACCESS_PASSWORD=admin
