generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CadSession {
  id           String   @id @default(cuid())
  prompt       String
  fileName     String?
  pythonScript String?
  parameters   Json?
  featureMap   Json?
  stlUrl       String?
  stepUrl      String?
  isShared     Boolean  @default(false)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  camSetups    CamSetup[]
  simulations  SimulationRun[]
}


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("User")
  password  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sessions CadSession[]
}

model ToolMaterial {
  id                            String   @id @default(cuid())
  material_code                 String   @unique
  material_name                 String
  description                   String?
  recommended_workpiece_materials String[]
  max_surface_speed             Float
  default_feed_multiplier       Float
  cost_factor                   Float
  is_active                     Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  tools         ToolDefinition[]
  cuttingData   CuttingData[]
}

model ToolCoating {
  id                       String   @id @default(cuid())
  coating_code             String   @unique
  coating_name             String
  description              String?
  recommended_materials    String[]
  surface_speed_multiplier Float
  wear_resistance_factor   Float
  is_active                Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tools         ToolDefinition[]
  cuttingData   CuttingData[]
}

model ToolHolder {
  id          String   @id @default(cuid())
  holder_name String   @unique
  holder_type String
  description String?
  max_rpm     Int
  is_active   Boolean  @default(true)

  tools ToolDefinition[]
}

model ToolDefinition {
  id             String   @id @default(cuid())
  name           String
  type           String
  diameter       Float
  flutes         Int
  stickout       Float
  manufacturer   String?
  material_id    String
  material       ToolMaterial @relation(fields: [material_id], references: [id])
  coating_id     String?
  coating        ToolCoating? @relation(fields: [coating_id], references: [id])
  holder_id      String?
  holder         ToolHolder?  @relation(fields: [holder_id], references: [id])
  is_active      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CuttingData {
  id                    String   @id @default(cuid())
  tool_material_id      String
  tool_material         ToolMaterial @relation(fields: [tool_material_id], references: [id])
  coating_id            String?
  coating               ToolCoating? @relation(fields: [coating_id], references: [id])
  workpiece_material    String // 'aluminum_6061', 'mild_steel', etc.
  surface_speed         Float
  feed_per_tooth        Float
  plunge_multiplier     Float
  rpm_formula           String?
  feed_formula          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([tool_material_id, coating_id, workpiece_material])
}

model CamSetup {
  id               String   @id @default(cuid())
  job_id           String
  session          CadSession @relation(fields: [job_id], references: [id], onDelete: Cascade)
  
  // Legacy fields (kept for additive migration)
  machine_id       String?
  material_id      String?
  stock_length     Float?
  stock_width      Float?
  stock_height     Float?
  wcs              String?
  origin           String?
  clearance_height Float?
  retract_height   Float?
  feed_height      Float?

  // Phase 2 Canonical Setup Data
  setupSchemaVersion Int      @default(1)
  machineType        String?    // e.g., "MILL_3X_VMC"
  machineProfileId   String?    // e.g., "haas_vf2"
  controllerId       String?    // e.g., "HAAS_NGC"
  postProcessorId    String?    // e.g., "AUTO"

  // Units
  internalUnits      String     @default("mm")
  displayUnits       String     @default("mm")
  postOutputUnits    String     @default("mm")

  // Hashes & Validation
  modelHash          String?
  setupHash          String?
  validationStatus   String     @default("incomplete") // e.g., "valid", "warning", "error", "incomplete"
  requiresSetupReview Boolean   @default(true)

  // Structured Data (JSON)
  stockDefinition        Json?
  originDefinition       Json?
  workCoordinateSystem   Json?
  orientation            Json?
  modelToSetupTransform  Json? // 4x4 matrix
  modelPlacement         Json?
  safetyHeights          Json?
  workholding            Json?
  tolerances             Json?
  
  tools            CamTool[]
  operations       CamOperation[]
  simulations      SimulationRun[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CamTool {
  id              String   @id @default(cuid())
  setup_id        String
  setup           CamSetup @relation(fields: [setup_id], references: [id], onDelete: Cascade)
  tool_number     Int?
  tool_name       String?
  tool_type       String
  diameter_mm     Float
  length_mm       Float
  flute_count     Int
  tool_material   String?
  coating         String?
  holder_type     String?
  h_offset        Float?
  d_offset        Float?
  length_offset_number Int?
  diameter_offset_number Int?
  stickout_mm     Float?
  material_compatibility String?
  
  operations      CamOperation[]
  segments        ToolpathSegment[]
}

model CamOperation {
  id               String   @id @default(cuid())
  setup_id         String
  setup            CamSetup @relation(fields: [setup_id], references: [id], onDelete: Cascade)
  feature_id       String?
  tool_id          String
  tool             CamTool  @relation(fields: [tool_id], references: [id])
  operation_type   String
  operation_order  Int
  rpm              Int?
  feed_rate        Float?
  plunge_rate      Float?
  stepdown         Float?
  stepover         Float?
  coolant_mode     String?
  status           String?
  blocked_reason   String?
  
  segments         ToolpathSegment[]
}

model ToolpathSegment {
  id                 String   @id @default(cuid())
  simulation_run_id  String
  simulation_run     SimulationRun @relation(fields: [simulation_run_id], references: [id], onDelete: Cascade)
  operation_id       String?
  operation          CamOperation? @relation(fields: [operation_id], references: [id])
  tool_id            String?
  tool               CamTool?      @relation(fields: [tool_id], references: [id])
  segment_index      Int
  move_type          String
  units              String   @default("mm")
  feed_mode          String?
  start_x            Float
  start_y            Float
  start_z            Float
  start_i            Float    @default(0)
  start_j            Float    @default(0)
  start_k            Float    @default(-1)
  end_x              Float
  end_y              Float
  end_z              Float
  end_i              Float    @default(0)
  end_j              Float    @default(0)
  end_k              Float    @default(-1)
  center_x           Float?
  center_y           Float?
  center_z           Float?
  radius             Float?
  feed_rate          Float?
  rpm                Int?
  length_mm          Float
  estimated_time_sec Float
}

model SimulationRun {
  id                   String   @id @default(cuid())
  job_id               String
  session              CadSession @relation(fields: [job_id], references: [id], onDelete: Cascade)
  setup_id             String
  setup                CamSetup   @relation(fields: [setup_id], references: [id], onDelete: Cascade)
  total_runtime_sec    Float
  total_distance_mm    Float
  cutting_distance_mm  Float
  rapid_distance_mm    Float
  status               String
  validation_status    String?
  validation_errors    Json?
  validation_warnings  Json?
  created_at           DateTime @default(now())

  segments             ToolpathSegment[]
  events               SimulationEvent[]
}

model SimulationEvent {
  id                 String   @id @default(cuid())
  simulation_run_id  String
  simulation_run     SimulationRun @relation(fields: [simulation_run_id], references: [id], onDelete: Cascade)
  event_type         String
  time_sec           Float
  operation_id       String?
  tool_id            String?
  message            String?
}

model Tool {
  id            String             @id @default(uuid())
  name          String             @unique
  category      String
  type          String
  description   String?
  manufacturer  String?
  partNumber    String?
  unit          String             @default("mm")
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  geometry      ToolGeometry?
  offsets       ToolOffset?
  assembly      ToolAssembly?
  cuttingData   ToolCuttingData?
  compatibility ToolCompatibility?
}

model ToolGeometry {
  id              String  @id @default(uuid())
  toolId          String  @unique
  tool            Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  diameter        Float
  cuttingDiameter Float?
  cornerRadius    Float?
  ballRadius      Float?
  fluteLength     Float
  cuttingLength   Float?
  overallLength   Float
  shankDiameter   Float?
  neckDiameter    Float?
  neckLength      Float?
  fluteCount      Int?
  helixAngle      Float?
  taperAngle      Float?
  pointAngle      Float?
  includedAngle   Float?
  cuttingWidth    Float?
  insertCount     Int?
  leadAngle       Float?
  arborDiameter   Float?
  profilePointsJson String? // Stored as JSON string
}

model ToolOffset {
  id             String  @id @default(uuid())
  toolId         String  @unique
  tool           Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  lengthOffset   Int
  diameterOffset Int
  headNumber     Int?
  compensationType String?
}

model Holder {
  id           String   @id @default(uuid())
  name         String   @unique
  type         String
  gaugeLength  Float
  diameter     Float
  shankSize    Float?
  taperType    String?
  manufacturer String?
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assemblies   ToolAssembly[]
}

model ToolAssembly {
  id                  String  @id @default(uuid())
  toolId              String  @unique
  tool                Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  holderId            String?
  holder              Holder? @relation(fields: [holderId], references: [id], onDelete: SetNull)
  stickoutLength      Float
  totalLength         Float?
  safeClearanceLength Float?
}

model ToolCuttingData {
  id           String  @id @default(uuid())
  toolId       String  @unique
  tool         Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  spindleRpm   Int
  feedRate     Float
  plungeRate   Float
  retractRate  Float
  coolant      String
  stepdown     Float?
  stepover     Float?
  chipLoad     Float?
  surfaceSpeed Float?
  feedPerTooth Float?
}

model ToolCompatibility {
  id                       String  @id @default(uuid())
  toolId                   String  @unique
  tool                     Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  compatibleOperationsJson String? // Stored as JSON array string
  compatibleMachinesJson   String? // Stored as JSON array string
  compatibleMaterialsJson  String? // Stored as JSON array string
  unsupportedReason        String?
}
