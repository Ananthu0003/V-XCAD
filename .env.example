# ─────────────────────────────────────────────────────────────────────────────
# VexCAD Root Docker Environment Variables
# Copy this file to .env and fill in your secrets before running docker-compose
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# AI Engine Variables
GOOGLE_API_KEY=your_google_ai_api_key_here
GENAI_MODEL=gemini-2.0-flash-lite
GENAI_MAX_RETRIES=5
GENAI_RETRY_BASE_DELAY=1.5
GENAI_MAX_RETRY_DELAY=75

# Internal API key for ai-engine authentication (web-ui → ai-engine)
# IMPORTANT: Generate a random key and use the SAME value in all .env files
INTERNAL_API_KEY=generate_a_random_key_here
