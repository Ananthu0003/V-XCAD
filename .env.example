# ─────────────────────────────────────────────────────────────────────────────
# VexCAD Docker Environment Variables
# Copy this file to .env and fill in your secrets before running docker-compose
# ─────────────────────────────────────────────────────────────────────────────

# AI Engine Variables
GOOGLE_API_KEY=your_google_ai_api_key_here
GENAI_MODEL=gemini-3.5-flash-lite
GENAI_MAX_RETRIES=5
GENAI_RETRY_BASE_DELAY=1.5
GENAI_MAX_RETRY_DELAY=75

# Web UI Variables
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Service-to-service credential: web-ui sends it as X-Service-Key, ai-engine requires it on every
# /api/v1 route. Server-side only — never put it in a NEXT_PUBLIC_* variable. Same value for both.
# Generate with: openssl rand -hex 32
SERVICE_API_KEY=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# There are NO default passwords. docker compose refuses to start until both are set.
# Use URL-safe values (hex/alphanumeric) — they are embedded in connection URLs.
#   Generate each with:  openssl rand -hex 24
#
# Admin/owner role: a cluster SUPERUSER by design of the postgres image. Used ONLY by the
# one-shot `migrate` service (schema + role setup). Never given to web-ui or ai-engine.
POSTGRES_ADMIN_PASSWORD=
# Least-privilege application role (DML only) used by web-ui and ai-engine. Min 16 characters.
POSTGRES_APP_PASSWORD=
# Optional overrides (defaults shown). Role names: lowercase letters, digits, underscore.
# POSTGRES_DB=cad_db
# POSTGRES_ADMIN_USER=vexcad_admin
# POSTGRES_APP_USER=vexcad_app
# Developer-only host port (docker-compose.dev.yml, bound to 127.0.0.1):
# POSTGRES_HOST_PORT=5433

# ── Rate limiting ────────────────────────────────────────────────────────────
# Leave unset/false unless a reverse proxy is the ONLY way to reach web-ui and it sets
# X-Forwarded-For itself. While web-ui is published directly, that header is attacker-controlled,
# so it must not be trusted (per-IP limits are then skipped; per-account/per-user limits still apply).
# TRUST_PROXY_HEADERS=false
