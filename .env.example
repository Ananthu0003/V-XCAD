# ─────────────────────────────────────────────────────────────────────────────
# VexCAD Docker Environment Variables
# Copy this file to .env and fill in your secrets before running docker-compose
# ─────────────────────────────────────────────────────────────────────────────

# AI Engine Variables
GOOGLE_API_KEY=your_google_ai_api_key_here
GENAI_MODEL=gemini-2.0-flash-lite
GENAI_MAX_RETRIES=5
GENAI_RETRY_BASE_DELAY=1.5
GENAI_MAX_RETRY_DELAY=75

# Web UI Variables
JWT_SECRET=super_secret_jwt_key_for_production_use

