+.mcad-workspace *::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.14); border-radius: 8px; border: 2px solid transparent; background-clip: padding-box; }
+.mcad-workspace *::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.24); background-clip: padding-box; }
+.mcad-workspace *::-webkit-scrollbar-track { background: transparent; }
+.mcad-workspace * { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.16) transparent; }
+
+.mcad-workspace input:not([type="checkbox"]):not([type="range"]),
+.mcad-workspace select { transition: border-color .15s, box-shadow .15s; }
+.mcad-workspace input:not([type="checkbox"]):not([type="range"]):hover,
+.mcad-workspace select:hover { border-color: var(--mcad-border-strong) !important; }
+.mcad-workspace input:focus-visible,
+.mcad-workspace select:focus-visible,
+.mcad-workspace textarea:focus-visible { outline: none; border-color: var(--mcad-accent) !important; box-shadow: var(--mcad-focus); }
+.mcad-workspace input[type="number"]::-webkit-inner-spin-button { opacity: 0; }
+.mcad-workspace input[type="number"]:hover::-webkit-inner-spin-button { opacity: .5; }
+.mcad-workspace input[type="checkbox"] { accent-color: var(--mcad-accent); }
+
+.mcad-workspace button { transition: background .15s, border-color .15s, color .15s, opacity .15s; }
+.mcad-workspace button:focus-visible { outline: none; box-shadow: var(--mcad-focus); }
+
+/* Buttons */
+.mcad-btn {
+  height: 34px; border-radius: var(--mcad-r-ctrl); font-size: 12px; font-weight: 500; font-family: var(--font-sans);
+  display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;
+  background: var(--mcad-input); border: 1px solid var(--mcad-border-ctrl); color: var(--mcad-text-primary);
+}
+.mcad-btn:hover:not(:disabled) { background: var(--mcad-segment-active); border-color: var(--mcad-border-strong); }
+.mcad-btn:disabled { opacity: .45; cursor: not-allowed; }
+.mcad-btn--primary { background: var(--mcad-accent); border-color: transparent; color: var(--mcad-on-accent); font-weight: 600; }
+.mcad-btn--primary:hover:not(:disabled) { background: var(--mcad-accent-hover); border-color: transparent; }
+.mcad-btn--ghost { height: 28px; padding: 0 10px; font-size: 11px; background: transparent; border-color: var(--mcad-border-ctrl); color: var(--mcad-text-secondary); }
+.mcad-btn--ghost:hover:not(:disabled) { color: var(--mcad-text-primary); }
