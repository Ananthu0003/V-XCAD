+/* ───────────── Manual CAD shared component styles ─────────────
+   Scoped to .mcad-workspace so nothing leaks to other stages. */
+.mcad-workspace { -webkit-font-smoothing: antialiased; }
+.mcad-workspace ::selection { background: rgba(76,123,244,0.35); }
+
