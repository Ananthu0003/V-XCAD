+.mcad-section:last-child { border-bottom: none; }
+.mcad-section-title { font: 600 11px var(--font-sans); letter-spacing: .06em; text-transform: uppercase; color: var(--mcad-text-muted); margin: 0 0 12px; }
+
+/* Prompt dock */
+.mcad-prompt {
+  display: flex; align-items: flex-end; gap: 8px; padding: 10px 10px 10px 18px;
+  background: var(--mcad-panel); border-radius: 22px; box-shadow: var(--mcad-shadow-card);
+}
+.mcad-prompt textarea {
+  flex: 1; resize: none; border: none; outline: none; background: transparent; color: var(--mcad-text-primary);
+  font: 400 14px/1.5 var(--font-sans); padding: 7px 0; max-height: 120px; min-height: 24px;
+}
+.mcad-prompt textarea::placeholder { color: var(--mcad-text-muted); }
+.mcad-prompt-send {
+  width: 36px; height: 36px; border-radius: 999px; border: none; cursor: pointer; flex-shrink: 0;
+  background: var(--mcad-accent); color: var(--mcad-on-accent); display: flex; align-items: center; justify-content: center;
+}
+.mcad-prompt-send:hover:not(:disabled) { background: var(--mcad-accent-hover); }
+.mcad-prompt-send:disabled { background: var(--mcad-input); color: var(--mcad-text-muted); cursor: not-allowed; }
+
