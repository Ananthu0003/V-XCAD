# Database connection string — the LEAST-PRIVILEGE application role (see README, "Database").
# Host-side development only: requires docker-compose.dev.yml (PostgreSQL bound to 127.0.0.1).
# Inside docker compose this is injected for you; do not reuse the admin role here.
DATABASE_URL=postgresql://vexcad_app:<POSTGRES_APP_PASSWORD>@127.0.0.1:5433/cad_db

# Service credential the web-ui BFF must send as X-Service-Key on every /api/v1 request.
# Required: the engine returns 503 for all /api/v1 routes while this is unset/blank.
SERVICE_API_KEY=

# Gemini API key used by ai-engine
GOOGLE_API_KEY=your_google_ai_api_key_here

# Primary model used for generation
GENAI_MODEL=gemini-3.1-flash-preview

# Retry/backoff tuning
GENAI_MAX_RETRIES=5
GENAI_RETRY_BASE_DELAY=1.5
GENAI_MAX_RETRY_DELAY=75

# OpenRouter API key for unified third-party model access
OPENROUTER_API_KEY=your_openrouter_api_key_here
