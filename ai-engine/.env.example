# Database connection string
DATABASE_URL=postgresql://cad_user:cad_pass@127.0.0.1:5433/cad_db

# Gemini API key used by ai-engine
GOOGLE_API_KEY=your_google_ai_api_key_here

# Primary model used for generation
GENAI_MODEL=gemini-3.1-flash-preview

# Retry/backoff tuning
GENAI_MAX_RETRIES=5
GENAI_RETRY_BASE_DELAY=1.5
GENAI_MAX_RETRY_DELAY=75

# OpenRouter API key for unified third-party model access
OPENROUTER_API_KEY=your_openrouter_api_key_here
